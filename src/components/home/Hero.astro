---
import { site } from "../../data/site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="container-wide hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Learning community</p>
      <h1 id="hero-title" class="brand-title">
        <span class="brand-line">
          <span class="brand-cyber">Cyber</span><span class="brand-crew">Crew</span>
        </span>
      </h1>
      <p class="headline">Learn with precision. Grow with the crew.</p>
      <p class="lede">
        {site.description}
      </p>
      <div class="actions">
        <a class="btn" href="/tracks">Explore learning tracks</a>
        <a class="btn btn-secondary" href="/library">Browse the library</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="badge-stage">
        <div class="ember" aria-hidden="true"></div>
        <div class="ring ring-outer" aria-hidden="true"></div>
        <div class="ring ring-inner" aria-hidden="true"></div>
        <picture>
          <source srcset="/brand/logo-hero.webp" type="image/webp" />
          <img
            src="/brand/logo-hero.jpg"
            alt="CyberCrew emblem — red geometric mark with CYBER CREW wordmark in a circular badge"
            width="1200"
            height="1200"
            class="hero-logo"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(2.25rem, 7vw, 4.5rem));
    padding-bottom: clamp(2.75rem, 7vw, 5rem);
    overflow: clip;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 46% 58% at 88% 42%, rgba(238, 34, 39, 0.14), transparent 62%),
      radial-gradient(ellipse 36% 48% at 8% 70%, rgba(46, 16, 16, 0.55), transparent 58%);
    mask-image: linear-gradient(180deg, black 55%, transparent 100%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .brand-title {
    margin: 0 0 0.85rem;
  }

  .brand-line {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.12em;
  }

  .brand-cyber {
    color: var(--cc-paper-bright);
    letter-spacing: -0.04em;
  }

  .brand-crew {
    color: var(--cc-accent);
    letter-spacing: -0.02em;
  }

  .headline {
    margin: 0 0 1rem;
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--cc-text);
  }

  .lede {
    margin: 0 0 1.75rem;
    max-width: 36rem;
    color: var(--cc-text-muted);
    font-size: 1.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero-visual {
    justify-self: center;
    width: min(100%, 30rem);
  }

  .badge-stage {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }

  .ember {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 40%, rgba(238, 34, 39, 0.32), transparent 52%),
      radial-gradient(circle at 72% 68%, rgba(46, 16, 16, 0.9), transparent 58%);
    filter: blur(3px);
    pointer-events: none;
    animation: ember-breathe 7s var(--ease-out) infinite;
  }

  .ring {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .ring-outer {
    inset: 0.5%;
    border: 1px solid color-mix(in srgb, var(--cc-accent-ring) 42%, transparent);
  }

  .ring-inner {
    inset: 4.5%;
    border: 1px dashed color-mix(in srgb, var(--cc-accent) 24%, transparent);
    animation: ring-drift 42s linear infinite;
  }

  .hero-logo {
    position: relative;
    z-index: 1;
    width: min(94%, 26rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 50%;
    box-shadow: var(--shadow-glow);
    animation: logo-settle 1.1s var(--ease-out) both;
  }

  @keyframes logo-settle {
    from {
      opacity: 0;
      transform: scale(0.94) translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes ember-breathe {
    0%,
    100% {
      opacity: 0.72;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.035);
    }
  }

  @keyframes ring-drift {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo,
    .ember,
    .ring-inner {
      animation: none;
    }
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(2rem, 4vw, 3rem);
    }

    .hero-visual {
      justify-self: end;
    }
  }
</style>
