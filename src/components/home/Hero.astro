---
import { site } from "../../data/site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <div class="container-wide hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Learning community</p>
      <h1 id="hero-title" class="brand-title">
        <span class="brand-line">
          <span class="brand-cyber">Cyber</span><span class="brand-crew">Crew</span>
        </span>
      </h1>
      <p class="headline">Learn with precision. Grow with the crew.</p>
      <p class="lede">
        {site.description}
      </p>
      <div class="actions">
        <a class="btn" href="/tracks">Explore learning tracks</a>
        <a class="btn btn-secondary" href="/library">Browse the library</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="emblem-stage">
        <div class="emblem-glow" aria-hidden="true"></div>
        <picture>
          <source srcset="/brand/logo-emblem.webp" type="image/webp" />
          <img
            src="/brand/logo-icon.svg"
            alt="CyberCrew emblem"
            width="512"
            height="495"
            class="hero-emblem"
            decoding="async"
            fetchpriority="high"
          />
        </picture>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(1.75rem, 5vw, 3.5rem));
    padding-bottom: clamp(2.25rem, 5vw, 4rem);
    overflow: clip;
  }

  .hero-atmosphere {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 50% at 90% 40%, rgba(238, 34, 39, 0.07), transparent 65%),
      radial-gradient(ellipse 34% 44% at 6% 72%, rgba(46, 16, 16, 0.35), transparent 60%);
    mask-image: linear-gradient(180deg, black 50%, transparent 100%);
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  .brand-title {
    margin: 0 0 0.65rem;
    font-size: clamp(2.35rem, 8vw, 4rem);
  }

  .brand-line {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.12em;
  }

  .brand-cyber {
    color: var(--cc-paper-bright);
    letter-spacing: -0.04em;
  }

  .brand-crew {
    color: var(--cc-accent);
    letter-spacing: -0.02em;
  }

  .headline {
    margin: 0 0 0.85rem;
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 2.6vw, 1.55rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--cc-text);
  }

  .lede {
    margin: 0 0 1.5rem;
    max-width: 34rem;
    color: var(--cc-text-muted);
    font-size: clamp(0.98rem, 2.2vw, 1.05rem);
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .actions .btn {
    flex: 1 1 auto;
    min-width: min(100%, 11rem);
  }

  .hero-visual {
    justify-self: center;
    width: min(100%, 18rem);
  }

  .emblem-stage {
    position: relative;
    aspect-ratio: 512 / 495;
    display: grid;
    place-items: center;
  }

  .emblem-glow {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 48%,
      color-mix(in srgb, var(--cc-accent) 22%, transparent),
      color-mix(in srgb, var(--cc-accent) 6%, transparent) 42%,
      transparent 70%
    );
    filter: blur(18px);
    pointer-events: none;
  }

  .hero-emblem {
    position: relative;
    z-index: 1;
    width: min(78%, 14.5rem);
    height: auto;
    aspect-ratio: 512 / 495;
    object-fit: contain;
    animation: emblem-settle 0.9s var(--ease-out) both;
  }

  @keyframes emblem-settle {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-emblem {
      animation: none;
    }
  }

  @media (min-width: 640px) {
    .hero-visual {
      width: min(100%, 20rem);
    }

    .hero-emblem {
      width: min(80%, 16rem);
    }

    .actions .btn {
      flex: 0 1 auto;
    }
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: clamp(2rem, 4vw, 3.25rem);
    }

    .hero-visual {
      justify-self: end;
      width: min(100%, 22rem);
    }

    .hero-emblem {
      width: min(82%, 17.5rem);
    }
  }
</style>
