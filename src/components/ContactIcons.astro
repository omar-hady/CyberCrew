---
import { site, socialLabel } from "../data/site";

interface Props {
  /** Larger icons + labels under each shortcut (community page). */
  size?: "sm" | "md";
}

const { size = "sm" } = Astro.props;

const icons: Record<string, string> = {
  email:
    "M2.5 5.5A1.5 1.5 0 0 1 4 4h16a1.5 1.5 0 0 1 1.5 1.5v13A1.5 1.5 0 0 1 20 20H4a1.5 1.5 0 0 1-1.5-1.5v-13Zm1.6.5 7.4 5.2a.9.9 0 0 0 1 0L20 6H4.1Zm15.9 1.7-6.7 4.7a2.4 2.4 0 0 1-2.6 0L4 8.2V18h16V8.2Z",
  discord:
    "M19.27 5.33A16.8 16.8 0 0 0 14.93 4l-.22.4a15.1 15.1 0 0 1 3.78 1.48 12.4 12.4 0 0 0-11 0A15.1 15.1 0 0 1 9.27 4.4L9.05 4a16.8 16.8 0 0 0-4.34 1.33C2.2 9.05 1.5 12.67 1.84 16.24A16.9 16.9 0 0 0 7.1 19l.7-1.02a10.9 10.9 0 0 1-1.7-.84l.4-.32a12 12 0 0 0 10.97 0l.4.32c-.55.33-1.12.61-1.7.84L16.9 19a16.9 16.9 0 0 0 5.26-2.76c.45-4.1-.5-7.68-2.89-10.91ZM8.68 14.32c-.9 0-1.64-.84-1.64-1.87s.73-1.87 1.64-1.87 1.65.84 1.65 1.87-.74 1.87-1.65 1.87Zm6.64 0c-.9 0-1.64-.84-1.64-1.87s.73-1.87 1.64-1.87 1.65.84 1.65 1.87-.74 1.87-1.65 1.87Z",
  whatsapp:
    "M12.04 2a9.94 9.94 0 0 0-8.6 14.95L2 22l5.2-1.37A9.94 9.94 0 1 0 12.04 2Zm0 1.8a8.14 8.14 0 0 1 6.9 12.2 8.1 8.1 0 0 1-6.9 3.48 8.05 8.05 0 0 1-4.08-1.1l-.29-.17-3.08.81.82-3-.19-.31A8.14 8.14 0 0 1 12.04 3.8Zm-2.9 3.4c-.23 0-.5.08-.7.37-.2.29-.87.85-.87 2.07s.89 2.4 1.01 2.56c.13.17 1.73 2.76 4.28 3.76 2.12.83 2.55.66 3.01.62.46-.04 1.49-.61 1.7-1.2.21-.58.21-1.08.15-1.2-.06-.11-.23-.18-.48-.31-.25-.13-1.49-.73-1.72-.82-.23-.08-.4-.13-.57.13-.17.25-.65.81-.8.98-.15.17-.29.19-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.5.12-.12.25-.29.38-.44.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.57-1.37-.78-1.87-.2-.48-.41-.42-.57-.42Z",
  github:
    "M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 6.8c.85 0 1.7.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.7-4.57 4.95.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z",
  linkedin:
    "M4.98 3.5A2.5 2.5 0 1 1 4.97 8.5 2.5 2.5 0 0 1 4.98 3.5ZM3.5 9.75h3V20.5h-3V9.75Zm5.25 0h2.88v1.46h.04c.4-.76 1.38-1.56 2.84-1.56 3.04 0 3.6 2 3.6 4.6v6.25h-3v-5.54c0-1.32-.02-3.02-1.84-3.02-1.84 0-2.12 1.44-2.12 2.92v5.64h-3V9.75Z",
  x: "M4 4h3.6l4.2 5.9L16.7 4H20l-6.1 7.1L20.5 20H16.9l-4.6-6.4L7.3 20H4l6.5-7.5L4 4Z",
};

type Shortcut = {
  key: string;
  href: string;
  label: string;
  external: boolean;
};

const shortcuts: Shortcut[] = [];

if (site.email.trim()) {
  shortcuts.push({
    key: "email",
    href: `mailto:${site.email.trim()}`,
    label: "Email",
    external: false,
  });
}

for (const [network, href] of Object.entries(site.social)) {
  if (!href?.trim()) continue;
  shortcuts.push({
    key: network,
    href: href.trim(),
    label: socialLabel(network),
    external: true,
  });
}
---

{
  shortcuts.length > 0 && (
    <ul class:list={["contact-icons", size === "md" && "is-md"]} role="list">
      {shortcuts.map((s) => (
        <li>
          <a
            class="contact-icon"
            href={s.href}
            aria-label={s.label}
            title={s.label}
            {...(s.external ? { rel: "noopener noreferrer", target: "_blank" } : {})}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d={icons[s.key] ?? icons.email} />
            </svg>
            {size === "md" && <span class="contact-icon-label">{s.label}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .contact-icons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .contact-icon {
    --icon-size: 1.15rem;
    --box: 2.5rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    width: var(--box);
    height: var(--box);
    color: var(--cc-text-muted);
    background: var(--cc-surface-2);
    border: 1px solid var(--cc-line-strong);
    text-decoration: none;
    transition:
      color var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out),
      background var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .contact-icon svg {
    width: var(--icon-size);
    height: var(--icon-size);
    display: block;
  }

  .contact-icon:hover {
    color: var(--cc-paper-bright);
    border-color: color-mix(in srgb, var(--cc-accent) 55%, var(--cc-line-strong));
    background: var(--cc-surface-3);
    transform: translateY(-1px);
  }

  .contact-icon:focus-visible {
    outline: 2px solid var(--cc-accent);
    outline-offset: 3px;
  }

  .contact-icon-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: inherit;
    line-height: 1;
  }

  .is-md .contact-icon {
    --icon-size: 1.35rem;
    --box: auto;
    min-width: 5.25rem;
    height: auto;
    padding: 0.85rem 0.9rem 0.75rem;
  }

  .is-md .contact-icon:hover {
    color: var(--cc-accent);
  }
</style>
