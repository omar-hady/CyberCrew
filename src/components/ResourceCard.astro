---
import type { Resource } from "../lib/resources";
import {
  difficultyLabel,
  resourceHref,
  trackLabel,
  typeLabel,
} from "../lib/resources";

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;
const { data } = resource;
---

<article class="resource-card panel">
  <div class="meta">
    <span class="tag tag-accent">{typeLabel[data.type]}</span>
    <span class="tag">{difficultyLabel[data.difficulty]}</span>
  </div>
  <h3>
    <a href={resourceHref(resource)}>{data.title}</a>
  </h3>
  <p>{data.description}</p>
  <div class="foot">
    <span>{trackLabel[data.track]}</span>
    <a class="more" href={resourceHref(resource)}>View</a>
  </div>
</article>

<style>
  .resource-card {
    padding: 1.25rem 1.35rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    transition:
      border-color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .resource-card:hover {
    border-color: color-mix(in srgb, var(--cc-accent) 40%, var(--cc-line));
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--cc-accent) 12%, transparent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  h3 a {
    color: var(--cc-paper-bright);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--cc-accent);
  }

  p {
    margin: 0;
    color: var(--cc-text-muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--cc-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--cc-text-faint);
  }

  .more {
    color: var(--cc-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .more:hover {
    color: var(--cc-paper-bright);
  }
</style>
