---
import type { Resource } from "../lib/resources";
import {
  difficultyLabel,
  resourceHref,
  trackLabel,
  typeLabel,
} from "../lib/resources";

interface Props {
  resource: Resource;
}

const { resource } = Astro.props;
const { data } = resource;
const href = resourceHref(resource);
---

<article class="resource-card panel">
  {
    data.thumbnail && (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <img src={data.thumbnail} alt="" width="640" height="360" loading="lazy" decoding="async" />
      </a>
    )
  }
  <div class="meta">
    <span class="tag tag-accent">{typeLabel[data.type]}</span>
    <span class="tag">{difficultyLabel[data.difficulty]}</span>
    {data.featured && <span class="tag">Featured</span>}
  </div>
  <h3>
    <a href={href}>{data.title}</a>
  </h3>
  <p>{data.description}</p>
  <div class="foot">
    <span>{trackLabel[data.track]}</span>
    <span class="more" aria-hidden="true">View</span>
  </div>
</article>

<style>
  .resource-card {
    padding: 1.25rem 1.35rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    transition:
      border-color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .resource-card:hover {
    border-color: color-mix(in srgb, var(--cc-accent) 40%, var(--cc-line));
    transform: translateY(-2px);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--cc-accent) 12%, transparent);
  }

  .thumb {
    display: block;
    margin: -0.35rem -0.45rem 0.15rem;
    overflow: hidden;
    border: 1px solid var(--cc-line);
    aspect-ratio: 16 / 9;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  h3 a {
    color: var(--cc-paper-bright);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--cc-accent);
  }

  p {
    margin: 0;
    color: var(--cc-text-muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--cc-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--cc-text-faint);
  }

  .more {
    color: var(--cc-accent);
    font-weight: 500;
  }

  .resource-card:hover .more {
    color: var(--cc-paper-bright);
  }
</style>
