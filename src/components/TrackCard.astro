---
interface Props {
  slug: string;
  title: string;
  short: string;
  level: string;
  index?: number;
}

const { slug, title, short, level, index = 0 } = Astro.props;
const num = String(index + 1).padStart(2, "0");
---

<a class="track-card panel" href={`/tracks/${slug}`}>
  <div class="top">
    <span class="idx" aria-hidden="true">{num}</span>
    <span class="level">{level}</span>
  </div>
  <h3>{title}</h3>
  <p>{short}</p>
  <span class="cta">Enter track →</span>
</a>

<style>
  .track-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem 1.2rem 1.15rem;
    text-decoration: none;
    color: inherit;
    min-height: 12.5rem;
    transition:
      border-color var(--duration) var(--ease-out),
      background var(--duration) var(--ease-out);
  }

  .track-card:hover {
    border-color: color-mix(in srgb, var(--cc-accent) 35%, var(--cc-line));
    background: var(--cc-surface-2);
    color: inherit;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .idx {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--cc-accent);
  }

  .level {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cc-text-faint);
  }

  h3 {
    margin: 0;
    font-size: clamp(1.15rem, 2.5vw, 1.3rem);
  }

  p {
    margin: 0;
    color: var(--cc-text-muted);
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .cta {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--cc-accent);
  }
</style>
