---
import CommunityLinks from "./CommunityLinks.astro";
import { site } from "../data/site";
import { getTracks } from "../lib/tracks";

const tracks = await getTracks();
const hasContact =
  Boolean(site.email.trim()) ||
  Object.values(site.social).some((href) => Boolean(href?.trim()));
---

<footer class="site-footer">
  <div class="container-wide footer-grid">
    <div class="footer-brand">
      <a class="footer-lockup" href="/" aria-label="CyberCrew home">
        <picture>
          <source srcset="/brand/logo-badge.webp" type="image/webp" />
          <img
            src="/brand/logo-badge.png"
            alt=""
            width="800"
            height="800"
            class="footer-logo"
            decoding="async"
          />
        </picture>
      </a>
      <p class="footer-tagline">{site.tagline}</p>
      {hasContact && <CommunityLinks size="sm" />}
    </div>

    <div>
      <h2 class="footer-heading">Explore</h2>
      <ul class="footer-links">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">Learning tracks</h2>
      <ul class="footer-links">
        {
          tracks.map((t) => (
            <li>
              <a href={`/tracks/${t.id}`}>{t.data.title}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">Resources</h2>
      <ul class="footer-links">
        <li><a href="/library">Resource library</a></li>
        <li><a href="/community">Community updates</a></li>
        <li><a href="/admin/" rel="nofollow">Content admin</a></li>
      </ul>
    </div>
  </div>

  <div class="container-wide footer-bottom">
    <div class="footer-bottom-meta">
      <p>© {new Date().getFullYear()} CyberCrew. Built for practical cybersecurity learning.</p>
      <p class="footer-credit">
        Built by{" "}
        <a href="https://www.linkedin.com/in/omarhadyalnajjar/" rel="noopener noreferrer" target="_blank">
          Omar AlNajjar
        </a>
      </p>
    </div>
    <p class="muted">
      Public static site — uploaded files committed to the repository are public.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--cc-line);
    background: var(--cc-ink-elevated);
    padding-block: var(--space-7) var(--space-6);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-6);
  }

  .footer-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
    margin-bottom: var(--space-3);
  }

  .footer-logo {
    width: clamp(3.75rem, 12vw, 4.75rem);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    border-radius: 50%;
    border: 1px solid var(--cc-line);
  }

  .footer-tagline {
    color: var(--cc-text-muted);
    max-width: 22rem;
    margin: 0;
    font-size: 0.95rem;
  }

  .footer-brand :global(.community-links) {
    margin-top: var(--space-4);
  }

  .footer-heading {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cc-accent);
    margin: 0 0 var(--space-3);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-links a {
    color: var(--cc-text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--cc-paper-bright);
  }

  .footer-bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--cc-line);
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--cc-text-faint);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.85rem;
  }

  .footer-credit {
    color: var(--cc-text-faint);
  }

  .footer-credit a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--cc-line) 80%, transparent);
  }

  .footer-credit a:hover {
    color: var(--cc-paper-bright);
    border-bottom-color: color-mix(in srgb, var(--cc-accent) 55%, transparent);
  }

  @media (min-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 960px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }
  }
</style>
