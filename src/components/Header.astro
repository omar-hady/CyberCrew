---
import { site } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container-wide header-inner">
    <a class="brand" href="/" aria-label="CyberCrew home" data-brand>
      <picture class="brand-picture">
        <source
          srcset="/brand/logo-horizontal-sm.webp 480w, /brand/logo-horizontal.webp 960w"
          sizes="(max-width: 640px) 9.5rem, 11.5rem"
          type="image/webp"
        />
        <img
          src="/brand/logo-horizontal.png"
          alt=""
          width="960"
          height="238"
          class="brand-mark"
          decoding="async"
          data-brand-mark
        />
      </picture>
      <span class="brand-fallback wordmark" data-brand-fallback hidden>
        <span class="wordmark-cyber">Cyber</span>
        <span class="wordmark-crew">Crew</span>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="btn btn-secondary header-cta" href="/tracks">Explore tracks</a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        data-menu-toggle
      >
        <span class="sr-only">Menu</span>
        <span class="menu-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" hidden data-mobile-nav>
    <nav aria-label="Mobile">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={["mobile-link", { active: isActive(item.href) }]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="btn" href="/tracks">Explore tracks</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    backdrop-filter: blur(14px);
    background: color-mix(in srgb, var(--cc-ink) 92%, transparent);
    border-bottom: 1px solid var(--cc-line);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .brand-picture {
    display: block;
    line-height: 0;
  }

  .brand-mark {
    width: clamp(8.5rem, 26vw, 10.75rem);
    height: auto;
    aspect-ratio: 960 / 238;
    object-fit: contain;
  }

  .brand-fallback {
    display: none;
  }

  .brand.is-fallback .brand-picture {
    display: none;
  }

  .brand.is-fallback .brand-fallback {
    display: flex;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.15rem;
    margin-inline: auto;
  }

  .nav-link {
    padding: 0.45rem 0.65rem;
    color: var(--cc-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    position: relative;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--cc-paper-bright);
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0.65rem;
    right: 0.65rem;
    bottom: 0.1rem;
    height: 2px;
    background: var(--cc-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .header-cta {
    display: none;
    min-height: 2.4rem;
    padding: 0.45rem 1rem;
    font-size: 0.85rem;
  }

  .menu-toggle {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--cc-line-strong);
    background: var(--cc-surface);
    color: var(--cc-paper);
    cursor: pointer;
    display: grid;
    place-items: center;
    clip-path: polygon(6px 0, 100% 0, 100% calc(100% - 6px), calc(100% - 6px) 100%, 0 100%, 0 6px);
  }

  .menu-bars,
  .menu-bars::before,
  .menu-bars::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    position: relative;
    transition: transform var(--duration) var(--ease-out);
  }

  .menu-bars::before,
  .menu-bars::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .menu-bars::before {
    top: -6px;
  }

  .menu-bars::after {
    top: 6px;
  }

  .menu-toggle[aria-expanded="true"] .menu-bars {
    background: transparent;
  }

  .menu-toggle[aria-expanded="true"] .menu-bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-nav {
    position: absolute;
    inset: var(--header-h) 0 auto;
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
    background: color-mix(in srgb, var(--cc-ink) 96%, var(--cc-ember));
    border-bottom: 1px solid var(--cc-line);
    padding: 0.75rem var(--gutter) 1.25rem;
  }

  .mobile-nav nav {
    display: grid;
    gap: 0.2rem;
  }

  .mobile-link {
    padding: 0.9rem 0.4rem;
    color: var(--cc-text);
    text-decoration: none;
    border-bottom: 1px solid var(--cc-line);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
  }

  .mobile-link.active {
    color: var(--cc-accent);
  }

  .mobile-nav .btn {
    margin-top: 0.85rem;
    width: 100%;
  }

  @media (min-width: 900px) {
    .desktop-nav {
      display: flex;
    }

    .header-cta {
      display: inline-flex;
    }

    .menu-toggle,
    .mobile-nav {
      display: none !important;
    }

    .header-actions {
      margin-left: 0;
    }
  }
</style>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const panel = document.querySelector("[data-mobile-nav]");
  const header = document.querySelector(".site-header");

  if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
    const focusables = () =>
      [
        toggle,
        ...panel.querySelectorAll<HTMLElement>("a, button, [tabindex]:not([tabindex='-1'])"),
      ].filter((el) => !el.hasAttribute("disabled") && el.offsetParent !== null);

    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      panel.hidden = !open;
      document.body.style.overflow = open ? "hidden" : "";
      if (open) {
        const first = panel.querySelector("a");
        if (first instanceof HTMLElement) first.focus();
      } else {
        toggle.focus();
      }
    };

    toggle.addEventListener("click", () => setOpen(!isOpen()));

    panel.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (e) => {
      if (!isOpen()) return;
      if (e.key === "Escape") {
        setOpen(false);
        return;
      }
      if (e.key !== "Tab") return;
      const items = focusables();
      if (items.length < 2) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    document.addEventListener("pointerdown", (e) => {
      if (!isOpen()) return;
      const target = e.target;
      if (!(target instanceof Node)) return;
      if (header?.contains(target)) return;
      setOpen(false);
    });
  }

  const brand = document.querySelector("[data-brand]");
  const brandMark = document.querySelector("[data-brand-mark]");
  if (brand instanceof HTMLElement && brandMark instanceof HTMLImageElement) {
    const showFallback = () => brand.classList.add("is-fallback");
    brandMark.addEventListener("error", showFallback);
    if (brandMark.complete && brandMark.naturalWidth === 0) showFallback();
  }
</script>
