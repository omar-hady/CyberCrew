---
interface Props {
  title: string;
  url?: string;
  note?: string;
}

const { title, url, note } = Astro.props;
---

{
  url ? (
    <a class="stage-suggestion" href={url} rel="noopener noreferrer" target="_blank">
      <div class="copy">
        <div class="meta">
          <span class="tag">External suggestion</span>
        </div>
        <span class="title">{title}</span>
        {note && <span class="desc">{note}</span>}
      </div>
      <span class="go" aria-hidden="true">Open</span>
    </a>
  ) : (
    <div class="stage-suggestion is-static">
      <div class="copy">
        <div class="meta">
          <span class="tag">External suggestion</span>
        </div>
        <span class="title">{title}</span>
        {note && <span class="desc">{note}</span>}
      </div>
    </div>
  )
}

<style>
  .stage-suggestion {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.85rem;
    align-items: center;
    padding: 0.85rem 0.95rem;
    text-decoration: none;
    color: inherit;
    background: transparent;
    border: 1px dashed var(--cc-line-strong);
    transition:
      border-color var(--duration) var(--ease-out),
      background var(--duration) var(--ease-out);
  }

  .stage-suggestion:not(.is-static):hover {
    border-color: color-mix(in srgb, var(--cc-accent) 32%, var(--cc-line));
    background: var(--cc-surface-2);
    color: inherit;
  }

  .copy {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--cc-paper-bright);
    line-height: 1.25;
  }

  .stage-suggestion:not(.is-static):hover .title {
    color: var(--cc-accent);
  }

  .desc {
    color: var(--cc-text-muted);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .go {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cc-accent);
  }
</style>
