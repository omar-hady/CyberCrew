---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import TrackCard from "../components/TrackCard.astro";
import ResourceCard from "../components/ResourceCard.astro";
import { getFeaturedResources } from "../lib/resources";
import { getLearningJourney, getTracks } from "../lib/tracks";
import { getCollection } from "astro:content";

const tracks = await getTracks();
const { foundations, core, specializations } = getLearningJourney(tracks);
const featured = await getFeaturedResources(4);
const announcements = (await getCollection("announcements"))
  .filter((a) => a.data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const journey = [
  {
    step: "01",
    title: "Foundations",
    text: "Prepare with Linux, networking, and basic computing — skip only what you already know.",
    href: foundations ? `/tracks/${foundations.id}` : "/tracks",
  },
  {
    step: "02",
    title: "Core skills",
    text: "Build shared ethics, web, tooling, and methodology before specializing.",
    href: core ? `/tracks/${core.id}` : "/tracks",
  },
  {
    step: "03",
    title: "Specialize",
    text: "Choose Red Team, Blue Team, or CTF and follow that path’s ordered stages.",
    href: "/tracks#specialize",
  },
  {
    step: "04",
    title: "Practice",
    text: "Use the library and CTF Arena when the platform link is live.",
    href: "/ctf",
  },
];
---

<BaseLayout>
  <Hero />

  <section class="signals-bar" aria-label="Learning focus areas">
    <div class="container-wide signals">
      <span>Foundations</span>
      <span>Core skills</span>
      <span>Red Team</span>
      <span>Blue Team</span>
      <span>CTF</span>
    </div>
  </section>

  <section class="section intro" aria-labelledby="intro-title">
    <div class="container reveal">
      <p class="eyebrow">What is CyberCrew</p>
      <div class="intro-grid">
        <h2 id="intro-title">Practical cybersecurity learning, together</h2>
        <div class="prose">
          <p class="muted">
            A clear journey from beginner foundations to specialization, a shared resource library,
            community sessions, and CTF practice — with ethics and methodology first, not hype.
          </p>
          <a class="btn btn-secondary" href="/about">About the community</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm tracks-section" aria-labelledby="tracks-title">
    <div class="container-wide">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Learning paths</p>
          <h2 id="tracks-title">Start here. Then specialize.</h2>
        </div>
        <a class="btn btn-secondary" href="/tracks">Full journey</a>
      </div>

      {
        (foundations || core) && (
          <div class="prep-grid">
            {foundations && (
              <div class="reveal">
                <TrackCard
                  slug={foundations.id}
                  title={foundations.data.title}
                  short={foundations.data.short}
                  level={foundations.data.level}
                  index={0}
                  journeyLevel={foundations.data.journeyLevel}
                  stageCount={foundations.data.stages.length}
                  cta="Start here →"
                />
              </div>
            )}
            {core && (
              <div class="reveal" style="transition-delay:60ms">
                <TrackCard
                  slug={core.id}
                  title={core.data.title}
                  short={core.data.short}
                  level={core.data.level}
                  index={1}
                  journeyLevel={core.data.journeyLevel}
                  stageCount={core.data.stages.length}
                />
              </div>
            )}
          </div>
        )
      }

      {
        specializations.length > 0 && (
          <div class="specs-block">
            <p class="specs-label muted">Then choose a specialization</p>
            <div class="grid-3">
              {specializations.map((t, i) => (
                <div class="reveal" style={`transition-delay:${i * 60}ms`}>
                  <TrackCard
                    slug={t.id}
                    title={t.data.title}
                    short={t.data.short}
                    level={t.data.level}
                    index={i}
                    focus={t.data.focus}
                    journeyLevel={t.data.journeyLevel}
                    stageCount={t.data.stages.length}
                  />
                </div>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section journey" aria-labelledby="journey-title">
    <div class="container">
      <div class="reveal">
        <p class="eyebrow">Learning journey</p>
        <h2 id="journey-title">A simple progression model</h2>
        <p class="muted lede">
          Foundations first, then shared core skills, then a specialization — no fake metrics or
          certificates.
        </p>
      </div>
      <ol class="journey-list">
        {
          journey.map((item, i) => (
            <li class="journey-item panel reveal" style={`transition-delay:${i * 70}ms`}>
              <span class="step">{item.step}</span>
              <div>
                <h3>
                  <a href={item.href}>{item.title}</a>
                </h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section-sm" aria-labelledby="featured-title">
    <div class="container-wide">
      <div class="section-head reveal">
        <div>
          <p class="eyebrow">Featured resources</p>
          <h2 id="featured-title">Start in the library</h2>
        </div>
        <a class="btn btn-secondary" href="/library">Open library</a>
      </div>
      {
        featured.length ? (
          <div class="grid-2">
            {featured.map((resource, i) => (
              <div class="reveal" style={`transition-delay:${i * 50}ms`}>
                <ResourceCard resource={resource} />
              </div>
            ))}
          </div>
        ) : (
          <div class="empty-state">
            <strong>No featured resources yet</strong>
            Publish resources in Decap CMS and mark them as featured.
          </div>
        )
      }
    </div>
  </section>

  <section class="section community-band" aria-labelledby="community-title">
    <div class="container-wide band panel reveal">
      <div>
        <p class="eyebrow">Community</p>
        <h2 id="community-title">Sessions, workshops, and updates</h2>
        <p class="muted">
          Workshops, practice nights, and library updates. Confirm dates in each post before you plan around them.
        </p>
        <a class="btn" href="/community">Community hub</a>
      </div>
      <ul class="announce-list">
        {
          announcements.map((a) => (
            <li>
              <span class="tag">{a.data.kind}</span>
              <div>
                <h3>
                  {a.data.link ? <a href={a.data.link}>{a.data.title}</a> : a.data.title}
                </h3>
                <p>{a.data.summary}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-sm cta-final" aria-labelledby="cta-title">
    <div class="container reveal">
      <div class="cta-panel panel">
        <h2 id="cta-title">Ready to train with intention?</h2>
        <p class="muted">
          Start with Foundations, build Core Skills, then specialize — and practice in the CTF Arena when the platform link is live.
        </p>
        <div class="actions">
          <a class="btn" href="/tracks">Open the journey</a>
          <a class="btn btn-secondary" href="/ctf">CTF Arena intro</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .signals-bar {
    padding-block: 0.85rem 1.5rem;
    border-bottom: 1px solid var(--cc-line);
  }

  .signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.15rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cc-text-faint);
  }

  .signals span {
    position: relative;
    padding-left: 0.95rem;
  }

  .signals span::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 5px;
    height: 5px;
    background: var(--cc-accent);
    transform: translateY(-50%) rotate(45deg);
  }

  .intro-grid {
    display: grid;
    gap: var(--space-5);
  }

  .intro-grid h2 {
    margin: 0;
    max-width: 14ch;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: 0;
  }

  .prep-grid,
  .grid-3 {
    display: grid;
    gap: var(--space-5);
  }

  .specs-block {
    margin-top: var(--space-6);
  }

  .specs-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .lede {
    max-width: 40rem;
  }

  .journey-list {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .journey-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding: 1.1rem 1.15rem;
    min-width: 0;
  }

  .journey-item .step {
    font-family: var(--font-mono);
    color: var(--cc-accent);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
  }

  .journey-item h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .journey-item h3 a {
    color: inherit;
    text-decoration: none;
  }

  .journey-item h3 a:hover {
    color: var(--cc-accent);
  }

  .journey-item p {
    margin: 0;
    color: var(--cc-text-muted);
    font-size: 0.95rem;
  }

  .band {
    display: grid;
    gap: var(--space-6);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .band h2 {
    margin: 0 0 0.75rem;
  }

  .announce-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .announce-list li {
    display: grid;
    gap: 0.55rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--cc-line);
  }

  .announce-list h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .announce-list h3 a {
    color: var(--cc-paper-bright);
    text-decoration: none;
  }

  .announce-list p {
    margin: 0.35rem 0 0;
    color: var(--cc-text-muted);
    font-size: 0.92rem;
  }

  .cta-panel {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    text-align: center;
    background: var(--cc-surface);
  }

  .community-band .band {
    background: var(--cc-surface);
  }

  .cta-panel h2 {
    margin: 0 0 0.75rem;
  }

  .cta-panel .muted {
    max-width: 36rem;
    margin: 0 auto 1.5rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .section-head .btn {
    width: 100%;
  }

  @media (min-width: 480px) {
    .section-head .btn {
      width: auto;
    }
  }

  @media (min-width: 720px) {
    .prep-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 860px) {
    .intro-grid {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
    }

    .journey-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .band {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
    }
  }
</style>
