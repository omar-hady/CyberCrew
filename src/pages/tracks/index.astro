---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrackCard from "../../components/TrackCard.astro";
import { getTracks } from "../../lib/tracks";

const tracks = await getTracks();
---

<BaseLayout
  title="Learning Tracks"
  description="Explore CyberCrew learning tracks for penetration testing, SOC & blue team, malware analysis, and CTF practice."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Curriculum paths</p>
      <h1>Learning tracks</h1>
      <p class="lede">
        Each track includes an introduction, objectives, an ordered roadmap, and matching library
        resources. Depth grows as the community publishes.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container-wide grid-2">
      {
        tracks.map((t, i) => (
          <TrackCard
            slug={t.id}
            title={t.data.title}
            short={t.data.short}
            level={t.data.level}
            index={i}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
